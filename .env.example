# ===============================================================
# QuakeGuard AI Environment Variables Example
# Duplicate this file as '.env' and fill in your values
# ===============================================================

# Flask Secret Key (Generate a random string: e.g. python -c "import secrets; print(secrets.token_hex(24))")
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Google Gemini API Key (Optional)
# If set, powers the AI Structural Consultant with Google Gemini 2.5 Flash.
# If omitted, the app automatically falls back to an authoritative offline RAG structural report.
GOOGLE_API_KEY=your_gemini_api_key_here

# MySQL Configuration (Optional)
# If omitted or if connection fails, QuakeGuard AI automatically defaults to SQLite (quakeguard.db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quakeguard
